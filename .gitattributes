# Auto-detect text files and normalize line endings
* text=auto

# Force Unix line endings for shell scripts
*.sh text eol=lf

# Force Unix line endings for other common config files
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

# Windows batch files should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
